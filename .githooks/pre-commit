#!/usr/bin/env bash
set -euo pipefail
git diff --cached --check
while IFS= read -r -d '' path; do
  case "$path" in
    .env|*/.env|.env.*|*/.env.*)
      [[ "${path##*/}" == .env.example ]] && continue
      printf 'Refusing environment file: %s\n' "$path" >&2; exit 1 ;;
    *.pem|*.key|.aws/*|.tools/*|.local/*)
      printf 'Refusing private/local file: %s\n' "$path" >&2; exit 1 ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
